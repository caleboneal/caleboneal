---
import { site } from '../data/site';

const emailAddress = site.links.email.replace(/^mailto:/i, '');

const links = [
	{
		label: 'X',
		href: site.links.x,
		icon: 'x' as const,
	},
	{
		label: 'LinkedIn',
		href: site.links.linkedin,
		icon: 'linkedin' as const,
	},
	{
		label: 'GitHub',
		href: site.links.github,
		icon: 'github' as const,
	},
	{
		label: 'Email',
		href: site.links.email,
		icon: 'email' as const,
		action: 'copy' as const,
	},
	{
		label: 'Resume',
		href: site.links.resume,
		icon: 'resume' as const,
		action: 'download' as const,
	},
];
---

<nav class="socials" aria-label="Social links">
	{
		links.map((link) => (
			<span class:list={['social', { 'has-action': 'action' in link && link.action }]}>
				<a class="icon-link" href={link.href} aria-label={link.label} title={link.label}>
					{link.icon === 'x' && (
						<svg viewBox="0 0 24 24" aria-hidden="true">
							<path
								fill="currentColor"
								d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.227-8.451L1.502 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
							/>
						</svg>
					)}
					{link.icon === 'linkedin' && (
						<svg viewBox="0 0 24 24" aria-hidden="true">
							<path
								fill="currentColor"
								d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0z"
							/>
						</svg>
					)}
					{link.icon === 'github' && (
						<svg viewBox="0 0 24 24" aria-hidden="true">
							<path
								fill="currentColor"
								d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
							/>
						</svg>
					)}
					{link.icon === 'email' && (
						<svg viewBox="0 0 24 24" aria-hidden="true">
							<path
								fill="currentColor"
								d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4-8 5-8-5V6l8 5 8-5z"
							/>
						</svg>
					)}
					{link.icon === 'resume' && (
						<svg viewBox="0 0 24 24" aria-hidden="true">
							<path
								fill="currentColor"
								d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zm0 2.5L17.5 8H14zM8 12h8v1.5H8zm0 3h8v1.5H8zm0 3h5v1.5H8z"
							/>
						</svg>
					)}
				</a>

				{'action' in link && link.action === 'copy' && (
					<button
						type="button"
						class="action"
						data-copy-email={emailAddress}
						aria-label="Copy email address"
						title="Copy email"
					>
						<svg viewBox="0 0 24 24" aria-hidden="true">
							<path
								fill="currentColor"
								d="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2m0 16H8V7h11z"
							/>
						</svg>
					</button>
				)}

				{'action' in link && link.action === 'download' && (
					<a
						class="action"
						href={link.href}
						download
						aria-label="Download resume"
						title="Download resume"
					>
						<svg viewBox="0 0 24 24" aria-hidden="true">
							<path
								fill="currentColor"
								d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2z"
							/>
						</svg>
					</a>
				)}
			</span>
		))
	}
</nav>

<div class="toast" id="copy-toast" role="status" aria-live="polite" hidden></div>

<script>
	let toastTimer: number | undefined;

	function showToast(message: string) {
		const toast = document.getElementById('copy-toast');
		if (!toast) return;

		toast.textContent = message;
		toast.hidden = false;
		toast.classList.remove('show');
		// retrigger enter animation
		void toast.offsetWidth;
		toast.classList.add('show');

		window.clearTimeout(toastTimer);
		toastTimer = window.setTimeout(() => {
			toast.classList.remove('show');
			window.setTimeout(() => {
				toast.hidden = true;
			}, 220);
		}, 2200);
	}

	function bindCopyEmail() {
		document.querySelectorAll<HTMLButtonElement>('[data-copy-email]').forEach((button) => {
			if (button.dataset.bound === 'true') return;
			button.dataset.bound = 'true';

			button.addEventListener('click', async () => {
				const email = button.dataset.copyEmail;
				if (!email) return;

				try {
					await navigator.clipboard.writeText(email);
					button.classList.add('copied');
					button.setAttribute('aria-label', 'Email copied');
					button.setAttribute('title', 'Copied');
					showToast(`Copied ${email}`);
					window.setTimeout(() => {
						button.classList.remove('copied');
						button.setAttribute('aria-label', 'Copy email address');
						button.setAttribute('title', 'Copy email');
					}, 1600);
				} catch {
					button.setAttribute('title', 'Copy failed');
					showToast('Couldn’t copy email');
				}
			});
		});
	}

	bindCopyEmail();
	document.addEventListener('astro:page-load', bindCopyEmail);
</script>

<style>
	.socials {
		display: flex;
		flex-wrap: wrap;
		justify-content: flex-end;
		align-items: center;
		gap: 0.55rem;
		/* room for action badges that sit past the icon edge */
		padding: 0.35rem 0.45rem 0.35rem 0;
	}

	@media (max-width: 768px) {
		.socials {
			justify-content: flex-start;
			padding: 0.35rem 0.45rem 0.35rem 0;
		}

		.action {
			display: none;
		}

		.social.has-action {
			margin-right: 0;
		}
	}

	.social {
		position: relative;
		display: inline-flex;
	}

	.social.has-action {
		margin-right: 0.35rem;
	}

	.icon-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.85rem;
		height: 2.85rem;
		border-radius: 999px;
		border: 1px solid color-mix(in srgb, var(--accent-orange) 40%, transparent);
		background-color: var(--bg);
		color: var(--accent-orange);
		/* Only animate hover motion — theme colors snap to avoid border flash */
		transition: transform 0.2s ease, color 0.2s ease;
	}

	.icon-link svg {
		width: 1.2rem;
		height: 1.2rem;
	}

	.icon-link:hover {
		transform: translateY(-1px);
		border-color: var(--accent-rose);
		color: var(--accent-rose);
	}

	.action {
		position: absolute;
		right: -0.25rem;
		bottom: -0.25rem;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1.35rem;
		height: 1.35rem;
		border-radius: 999px;
		appearance: none;
		-webkit-appearance: none;
		border: 1px solid color-mix(in srgb, var(--accent-orange) 45%, transparent);
		/* Match parent icon fill without a --bg halo ring (halo flashed on theme change) */
		background-color: color-mix(in srgb, var(--accent-orange) 10%, var(--bg));
		color: var(--accent-orange);
		box-shadow: none;
		transition: transform 0.2s ease, color 0.2s ease;
	}

	.action svg {
		width: 0.75rem;
		height: 0.75rem;
	}

	.action:hover {
		border-color: var(--accent-rose);
		color: var(--accent-rose);
		transform: scale(1.06);
	}

	.action.copied {
		border-color: var(--accent-rose);
		color: var(--accent-rose);
	}

	.toast {
		position: fixed;
		left: 50%;
		bottom: 1.75rem;
		z-index: 50;
		padding: 0.7rem 1.1rem;
		border-radius: 999px;
		border: 1px solid color-mix(in srgb, var(--accent-orange) 35%, var(--hairline));
		background: color-mix(in srgb, var(--bg) 92%, var(--accent-orange));
		color: var(--fg);
		font-size: 0.85rem;
		font-weight: 500;
		letter-spacing: 0.01em;
		box-shadow: 0 8px 28px rgba(0, 0, 0, 0.18);
		transform: translate(-50%, 0.6rem);
		opacity: 0;
		pointer-events: none;
		transition:
			opacity 0.22s ease,
			transform 0.22s ease;
	}

	.toast.show {
		opacity: 1;
		transform: translate(-50%, 0);
	}
</style>
