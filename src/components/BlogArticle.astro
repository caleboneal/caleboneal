---
import { formatDate } from '../utils/formatDate';
import '../styles/prose.css';

interface Props {
	title: string;
	description?: string;
	date?: Date;
	backHref?: string;
	backLabel?: string;
}

const {
	title,
	date,
	backHref = '/',
	backLabel = '← Back',
} = Astro.props;

const formattedDate = date ? formatDate(date) : null;
---

<article class="post">
	<a class="back" href={backHref}>{backLabel}</a>
	<header class="header">
		<slot name="title">
			<h1>{title}</h1>
		</slot>
		{formattedDate && date && <time datetime={date.toISOString()}>{formattedDate}</time>}
	</header>
	<div class="content prose">
		<slot />
	</div>
</article>

<style>
	.post {
		padding: 2.5rem 0 2.5rem;
		max-width: 42rem;
	}

	.back {
		display: inline-block;
		margin-bottom: 2rem;
		color: var(--muted);
		font-size: 0.875rem;
		transition: color 0.2s ease;
	}

	.back:hover {
		color: var(--accent-rose);
	}

	.header {
		margin-bottom: 2rem;
		padding-bottom: 1.5rem;
		border-bottom: 1px solid var(--hairline);
	}

	.header :global(h1) {
		margin: 0 0 0.75rem;
		font-size: clamp(1.85rem, 4vw, 2.6rem);
		font-weight: 700;
		letter-spacing: -0.03em;
		line-height: 1.15;
	}

	.header time {
		color: var(--muted);
		font-size: 0.9rem;
	}
</style>
