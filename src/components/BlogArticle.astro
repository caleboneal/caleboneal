---
import { formatDate } from '../utils/formatDate';
import { formatReadingTime } from '../utils/readingTime';
import '../styles/prose.css';

interface AdjacentPost {
	href: string;
	title: string;
}

interface Props {
	title: string;
	description?: string;
	date?: Date;
	updatedDate?: Date;
	readingTime?: number;
	number?: number;
	previous?: AdjacentPost;
	next?: AdjacentPost;
	backHref?: string;
	backLabel?: string;
}

const {
	title,
	description,
	date,
	updatedDate,
	readingTime,
	number,
	previous,
	next,
	backHref = '/',
	backLabel = '← Back',
} = Astro.props;

const formattedDate = date ? formatDate(date) : null;
const formattedUpdated =
	updatedDate && (!date || updatedDate.valueOf() !== date.valueOf())
		? formatDate(updatedDate)
		: null;
const readingLabel = readingTime !== undefined ? formatReadingTime(readingTime) : null;
---

<article class="post">
	<div class="post-body">
		<a class="back" href={backHref} data-nav-transition="fade" data-astro-prefetch="hover">
			{backLabel}
		</a>
		<header class="header">
			<slot name="title">
				<h1>
					{number !== undefined && <span class="number">{number}</span>}
					{title}
				</h1>
			</slot>
			{(formattedDate && date) || formattedUpdated || readingLabel || description ? (
				<div class="meta">
					{(formattedDate && date) || formattedUpdated || readingLabel ? (
						<p class="byline">
							{formattedDate && date && (
								<time datetime={date.toISOString()}>{formattedDate}</time>
							)}
							{formattedUpdated && updatedDate && (
								<>
									{formattedDate && date && <span class="sep" aria-hidden="true">·</span>}
									<span>
										Updated{' '}
										<time datetime={updatedDate.toISOString()}>{formattedUpdated}</time>
									</span>
								</>
							)}
							{readingLabel && (
								<>
									{(formattedDate && date) || formattedUpdated ? (
										<span class="sep" aria-hidden="true">·</span>
									) : null}
									<span>{readingLabel}</span>
								</>
							)}
						</p>
					) : null}
					{description && <p class="summary">{description}</p>}
				</div>
			) : null}
		</header>
		<div class="content prose">
			<slot />
		</div>
	</div>
	{(previous || next) && (
		<nav class="post-nav" aria-label="Post navigation">
			{previous ? (
				<a
					class="nav-link prev"
					href={previous.href}
					data-astro-prefetch="hover"
					data-nav-transition="slide-back"
				>
					<span class="nav-label">Previous</span>
					<span class="nav-title">{previous.title}</span>
				</a>
			) : (
				<span class="nav-spacer" />
			)}
			{next ? (
				<a
					class="nav-link next"
					href={next.href}
					data-astro-prefetch="hover"
					data-nav-transition="slide-forward"
				>
					<span class="nav-label">Next</span>
					<span class="nav-title">{next.title}</span>
				</a>
			) : (
				<span class="nav-spacer" />
			)}
		</nav>
	)}
</article>

<style>
	.post {
		display: flex;
		flex-direction: column;
		flex: 1;
		width: 100%;
		min-height: 100%;
		padding: 2.5rem 0;
	}

	.post-body {
		max-width: 42rem;
	}

	.back,
	.header,
	.content :global(> *),
	.post-nav {
		opacity: 0;
		transform: translateY(-0.55rem);
		animation: article-enter 420ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
	}

	.back {
		animation-delay: 80ms;
	}

	.header {
		animation-delay: 135ms;
	}

	.content :global(> *:nth-child(1)) {
		animation-delay: 190ms;
	}
	.content :global(> *:nth-child(2)) {
		animation-delay: 245ms;
	}
	.content :global(> *:nth-child(3)) {
		animation-delay: 300ms;
	}
	.content :global(> *:nth-child(4)) {
		animation-delay: 355ms;
	}
	.content :global(> *:nth-child(5)) {
		animation-delay: 410ms;
	}
	.content :global(> *:nth-child(6)) {
		animation-delay: 465ms;
	}
	.content :global(> *:nth-child(7)) {
		animation-delay: 520ms;
	}
	.content :global(> *:nth-child(8)) {
		animation-delay: 575ms;
	}
	.content :global(> *:nth-child(9)) {
		animation-delay: 630ms;
	}
	.content :global(> *:nth-child(10)) {
		animation-delay: 685ms;
	}
	.content :global(> *:nth-child(11)) {
		animation-delay: 740ms;
	}
	.content :global(> *:nth-child(12)) {
		animation-delay: 795ms;
	}
	.content :global(> *:nth-child(n + 13)) {
		animation-delay: 850ms;
	}

	.post-nav {
		animation-delay: 410ms;
	}

	@keyframes article-enter {
		from {
			opacity: 0;
			transform: translateY(-0.55rem);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.back,
		.header,
		.content :global(> *),
		.post-nav {
			opacity: 1;
			transform: none;
			animation: none;
		}
	}

	.back {
		display: inline-block;
		margin-bottom: 2rem;
		color: var(--muted);
		font-size: 0.875rem;
		transition: color 0.2s ease;
	}

	.back:hover {
		color: var(--accent-rose);
	}

	.header {
		margin-bottom: 2rem;
		padding-bottom: 1.5rem;
		border-bottom: 1px solid var(--hairline);
	}

	.header :global(h1) {
		display: flex;
		align-items: baseline;
		margin: 0 0 0.75rem;
		font-size: clamp(1.85rem, 4vw, 2.6rem);
		font-weight: 700;
		letter-spacing: -0.03em;
		line-height: 1.15;
	}

	.number {
		flex-shrink: 0;
		color: color-mix(in srgb, var(--muted) 55%, transparent);
		font-size: 0.72em;
		font-variant-numeric: tabular-nums;
		font-weight: 500;
		letter-spacing: 0;
		padding-right: 0.85rem;
		margin-right: 0.85rem;
		border-right: 1px solid var(--hairline);
	}

	.header time {
		color: inherit;
		font-size: inherit;
	}

	.meta {
		display: flex;
		flex-direction: column;
		gap: 0.65rem;
	}

	.byline {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.35rem 0.5rem;
		margin: 0;
		color: var(--muted);
		font-size: 0.9rem;
	}

	.sep {
		color: color-mix(in srgb, var(--muted) 70%, transparent);
	}

	.summary {
		margin: 0;
		color: var(--muted);
		font-size: 1.05rem;
		line-height: 1.45;
		letter-spacing: -0.01em;
		max-width: 36rem;
	}

	.post-nav {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		gap: 1.5rem;
		width: 100%;
		margin-top: auto;
		padding-top: 2.5rem;
	}

	.nav-spacer {
		flex: 1;
		min-width: 0;
	}

	.nav-link {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		max-width: min(45%, 22rem);
		color: var(--muted);
		transition: color 0.2s ease;
	}

	.nav-link:hover {
		color: var(--accent-rose);
	}

	.nav-link.next {
		margin-left: auto;
		align-items: flex-end;
		text-align: right;
	}

	.nav-label {
		font-size: 0.75rem;
		font-weight: 500;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.nav-title {
		font-size: 0.95rem;
		font-weight: 500;
		letter-spacing: -0.01em;
		line-height: 1.35;
		color: var(--fg);
		transition: color 0.2s ease;
	}

	.nav-link:hover .nav-title {
		color: var(--accent-rose);
	}

	@media (max-width: 640px) {
		.post-nav {
			flex-direction: column;
			gap: 1.25rem;
		}

		.nav-link {
			max-width: 100%;
		}

		.nav-link.next {
			margin-left: 0;
			align-items: flex-start;
			text-align: left;
		}

		.nav-spacer {
			display: none;
		}
	}
</style>
