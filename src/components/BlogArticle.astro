---
import { formatDate } from '../utils/formatDate';
import '../styles/prose.css';

interface AdjacentPost {
	href: string;
	title: string;
}

interface Props {
	title: string;
	date?: Date;
	number?: number;
	previous?: AdjacentPost;
	next?: AdjacentPost;
	backHref?: string;
	backLabel?: string;
}

const {
	title,
	date,
	number,
	previous,
	next,
	backHref = '/',
	backLabel = '← Back',
} = Astro.props;

const formattedDate = date ? formatDate(date) : null;
---

<article class="post">
	<div class="post-body">
		<a class="back" href={backHref}>{backLabel}</a>
		<header class="header">
			<slot name="title">
				<h1>
					{number !== undefined && <span class="number">{number}</span>}
					{title}
				</h1>
			</slot>
			{formattedDate && date && <time datetime={date.toISOString()}>{formattedDate}</time>}
		</header>
		<div class="content prose">
			<slot />
		</div>
	</div>
	{(previous || next) && (
		<nav class="post-nav" aria-label="Post navigation">
			{previous ? (
				<a class="nav-link prev" href={previous.href} data-astro-prefetch="hover">
					<span class="nav-label">Previous</span>
					<span class="nav-title">{previous.title}</span>
				</a>
			) : (
				<span class="nav-spacer" />
			)}
			{next ? (
				<a class="nav-link next" href={next.href} data-astro-prefetch="hover">
					<span class="nav-label">Next</span>
					<span class="nav-title">{next.title}</span>
				</a>
			) : (
				<span class="nav-spacer" />
			)}
		</nav>
	)}
</article>

<style>
	.post {
		display: flex;
		flex-direction: column;
		flex: 1;
		width: 100%;
		min-height: 100%;
		padding: 2.5rem 0;
	}

	.post-body {
		max-width: 42rem;
	}

	.back {
		display: inline-block;
		margin-bottom: 2rem;
		color: var(--muted);
		font-size: 0.875rem;
		transition: color 0.2s ease;
	}

	.back:hover {
		color: var(--accent-rose);
	}

	.header {
		margin-bottom: 2rem;
		padding-bottom: 1.5rem;
		border-bottom: 1px solid var(--hairline);
	}

	.header :global(h1) {
		display: flex;
		align-items: baseline;
		margin: 0 0 0.75rem;
		font-size: clamp(1.85rem, 4vw, 2.6rem);
		font-weight: 700;
		letter-spacing: -0.03em;
		line-height: 1.15;
	}

	.number {
		flex-shrink: 0;
		color: color-mix(in srgb, var(--muted) 55%, transparent);
		font-size: 0.72em;
		font-variant-numeric: tabular-nums;
		font-weight: 500;
		letter-spacing: 0;
		padding-right: 0.85rem;
		margin-right: 0.85rem;
		border-right: 1px solid var(--hairline);
	}

	.header time {
		color: var(--muted);
		font-size: 0.9rem;
	}

	.post-nav {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		gap: 1.5rem;
		width: 100%;
		margin-top: auto;
		padding-top: 2.5rem;
	}

	.nav-spacer {
		flex: 1;
		min-width: 0;
	}

	.nav-link {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		max-width: min(45%, 22rem);
		color: var(--muted);
		transition: color 0.2s ease;
	}

	.nav-link:hover {
		color: var(--accent-rose);
	}

	.nav-link.next {
		margin-left: auto;
		align-items: flex-end;
		text-align: right;
	}

	.nav-label {
		font-size: 0.75rem;
		font-weight: 500;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.nav-title {
		font-size: 0.95rem;
		font-weight: 500;
		letter-spacing: -0.01em;
		line-height: 1.35;
		color: var(--fg);
		transition: color 0.2s ease;
	}

	.nav-link:hover .nav-title {
		color: var(--accent-rose);
	}

	@media (max-width: 640px) {
		.post-nav {
			flex-direction: column;
			gap: 1.25rem;
		}

		.nav-link {
			max-width: 100%;
		}

		.nav-link.next {
			margin-left: 0;
			align-items: flex-start;
			text-align: left;
		}

		.nav-spacer {
			display: none;
		}
	}
</style>
