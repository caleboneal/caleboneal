---
import { formatDate } from '../utils/formatDate';

interface Props {
	title: string;
	description?: string;
	date?: Date;
	backHref?: string;
	backLabel?: string;
}

const {
	title,
	date,
	backHref = '/',
	backLabel = '← Back',
} = Astro.props;

const formattedDate = date ? formatDate(date) : null;
---

<article class="post">
	<a class="back" href={backHref}>{backLabel}</a>
	<header class="header">
		<slot name="title">
			<h1>{title}</h1>
		</slot>
		{formattedDate && date && <time datetime={date.toISOString()}>{formattedDate}</time>}
	</header>
	<div class="content">
		<slot />
	</div>
</article>

<style>
	.post {
		padding: 2.5rem 0 2.5rem;
		max-width: 42rem;
	}

	.back {
		display: inline-block;
		margin-bottom: 2rem;
		color: var(--muted);
		font-size: 0.875rem;
		transition: color 0.2s ease;
	}

	.back:hover {
		color: var(--accent-rose);
	}

	.header {
		margin-bottom: 2rem;
		padding-bottom: 1.5rem;
		border-bottom: 1px solid var(--hairline);
	}

	.header :global(h1) {
		margin: 0 0 0.75rem;
		font-size: clamp(1.85rem, 4vw, 2.6rem);
		font-weight: 700;
		letter-spacing: -0.03em;
		line-height: 1.15;
	}

	.header time {
		color: var(--muted);
		font-size: 0.9rem;
	}

	.content :global(p) {
		margin: 0 0 1.15rem;
		color: color-mix(in srgb, var(--fg) 88%, var(--muted));
		font-size: 1.05rem;
		line-height: 1.7;
	}

	.content :global(p:last-child) {
		margin-bottom: 0;
	}

	.content :global(a) {
		color: var(--accent-orange);
		text-decoration: underline;
		text-underline-offset: 0.15em;
	}

	.content :global(a:hover) {
		color: var(--accent-rose);
	}

	.content :global(strong) {
		color: var(--fg);
		font-weight: 700;
	}

	.content :global(em) {
		font-style: italic;
	}

	.content :global(h1),
	.content :global(h2),
	.content :global(h3),
	.content :global(h4),
	.content :global(h5),
	.content :global(h6) {
		margin: 2rem 0 0.75rem;
		color: var(--fg);
		font-weight: 700;
		letter-spacing: -0.02em;
		line-height: 1.25;
	}

	.content :global(h1) {
		font-size: 1.85rem;
	}

	.content :global(h2) {
		font-size: 1.5rem;
	}

	.content :global(h3) {
		font-size: 1.25rem;
	}

	.content :global(h4) {
		font-size: 1.1rem;
	}

	.content :global(h5),
	.content :global(h6) {
		font-size: 1rem;
	}

	.content :global(ul),
	.content :global(ol) {
		margin: 0 0 1.15rem;
		padding-left: 1.25rem;
		color: color-mix(in srgb, var(--fg) 88%, var(--muted));
		font-size: 1.05rem;
		line-height: 1.7;
	}

	.content :global(li + li) {
		margin-top: 0.35rem;
	}

	.content :global(li > ul),
	.content :global(li > ol) {
		margin: 0.35rem 0 0;
	}

	.content :global(blockquote) {
		margin: 0 0 1.15rem;
		padding: 0.15rem 0 0.15rem 1rem;
		border-left: 2px solid color-mix(in srgb, var(--accent-orange) 55%, var(--hairline));
		color: var(--muted);
		font-style: italic;
	}

	.content :global(blockquote p:last-child) {
		margin-bottom: 0;
	}

	.content :global(hr) {
		margin: 2rem 0;
		border: 0;
		border-top: 1px solid var(--hairline);
	}

	.content :global(code) {
		font-family: ui-monospace, 'Cascadia Code', 'Segoe UI Mono', monospace;
		font-size: 0.9em;
		padding: 0.12em 0.35em;
		border-radius: 0.3rem;
		background: color-mix(in srgb, var(--fg) 6%, transparent);
		color: var(--fg);
	}

	.content :global(pre) {
		margin: 0 0 1.15rem;
		padding: 0;
		overflow: visible;
		border: 0;
		background: transparent;
		font-size: inherit;
		line-height: inherit;
	}

	.content :global(pre.astro-code) {
		margin: 0 0 1.15rem;
		padding: 1rem 1.1rem;
		overflow-x: auto;
		border-radius: 0.65rem;
		border: 1px solid var(--hairline);
		background-color: var(--shiki-light-bg);
		font-size: 0.9rem;
		line-height: 1.55;
	}

	:global(html[data-theme='dark']) .content :global(pre.astro-code) {
		background-color: var(--shiki-dark-bg);
	}

	.content :global(pre code) {
		padding: 0;
		background: none;
		color: inherit;
		font-size: inherit;
		border-radius: 0;
	}

	.content :global(table) {
		width: 100%;
		margin: 0 0 1.15rem;
		border-collapse: collapse;
		font-size: 0.95rem;
		line-height: 1.5;
	}

	.content :global(th),
	.content :global(td) {
		padding: 0.65rem 0.75rem;
		border: 1px solid var(--hairline);
		text-align: left;
	}

	.content :global(th) {
		color: var(--fg);
		font-weight: 600;
		background: color-mix(in srgb, var(--fg) 4%, transparent);
	}

	.content :global(img) {
		display: block;
		max-width: 100%;
		height: auto;
		margin: 0 0 1.15rem;
		border-radius: 0.5rem;
	}

	.content :global(figure) {
		margin: 0 0 1.15rem;
	}

	.content :global(figcaption) {
		margin-top: 0.5rem;
		color: var(--muted);
		font-size: 0.875rem;
		text-align: center;
	}
</style>
