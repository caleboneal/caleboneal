---
import { site } from '../data/site';
import SocialLinks from './SocialLinks.astro';

const cx = 320;
const cy = 260;

/** Point on a circle at degrees (0 = right, CCW). */
function point(radius: number, deg: number) {
	const rad = (deg * Math.PI) / 180;
	return {
		x: +(cx + radius * Math.cos(rad)).toFixed(2),
		y: +(cy + radius * Math.sin(rad)).toFixed(2),
	};
}

const orbits = [
	{
		id: 'a',
		r: 34,
		width: 1.35,
		dash: '165 50',
		opacity: 0.9,
		duration: '42s',
		reverse: false,
		gradient: 'warm',
		rotate: 210,
		dots: [{ deg: 250, kind: 'solid', size: 2.4 }],
	},
	{
		id: 'b',
		r: 51,
		width: 0.7,
		dash: '1.1 5.5',
		opacity: 0.55,
		duration: '56s',
		reverse: true,
		gradient: 'cool',
		rotate: 35,
		dots: [{ deg: 120, kind: 'hollow', size: 3.2 }],
	},
	{
		id: 'c',
		r: 68,
		width: 1.6,
		dash: '155 45 95 130',
		opacity: 0.85,
		duration: '68s',
		reverse: false,
		gradient: 'warm',
		rotate: 300,
		dots: [
			{ deg: 40, kind: 'solid', size: 2.8 },
			{ deg: 200, kind: 'hollow', size: 3.5 },
		],
	},
	{
		id: 'd',
		r: 96,
		width: 0.85,
		dash: '380 220',
		opacity: 0.65,
		duration: '80s',
		reverse: true,
		gradient: 'cool',
		rotate: 145,
		dots: [{ deg: 310, kind: 'solid', size: 2.2 }],
	},
	{
		id: 'e',
		r: 114,
		width: 2.1,
		dash: '95 28 70 35 200 280',
		opacity: 0.75,
		duration: '94s',
		reverse: false,
		gradient: 'warm',
		rotate: 70,
		dots: [
			{ deg: 160, kind: 'hollow', size: 4 },
			{ deg: 5, kind: 'solid', size: 2.6 },
		],
	},
	{
		id: 'f',
		r: 142,
		width: 0.65,
		dash: '0.9 4.2',
		opacity: 0.45,
		duration: '108s',
		reverse: true,
		gradient: 'cool',
		rotate: 250,
		dots: [{ deg: 85, kind: 'hollow', size: 2.8 }],
	},
	{
		id: 'g',
		r: 158,
		width: 1.15,
		dash: '520 470',
		opacity: 0.7,
		duration: '118s',
		reverse: false,
		gradient: 'warm',
		rotate: 5,
		dots: [{ deg: 275, kind: 'solid', size: 3 }],
	},
	{
		id: 'h',
		r: 188,
		width: 1.9,
		dash: '180 40 120 50 280 500',
		opacity: 0.8,
		duration: '132s',
		reverse: true,
		gradient: 'cool',
		rotate: 185,
		dots: [
			{ deg: 55, kind: 'solid', size: 2.5 },
			{ deg: 220, kind: 'hollow', size: 4.2 },
		],
	},
	{
		id: 'i',
		r: 214,
		width: 0.75,
		dash: '1.4 7',
		opacity: 0.4,
		duration: '148s',
		reverse: false,
		gradient: 'warm',
		rotate: 320,
		dots: [{ deg: 140, kind: 'hollow', size: 3.1 }],
	},
	{
		id: 'j',
		r: 238,
		width: 1.4,
		dash: '420 80 260 730',
		opacity: 0.6,
		duration: '164s',
		reverse: true,
		gradient: 'cool',
		rotate: 110,
		dots: [{ deg: 345, kind: 'solid', size: 2.7 }],
	},
] as const;
---

<section class="hero">
	<div class="glow" aria-hidden="true"></div>
	<div class="orbit-stage" aria-hidden="true">
		<svg class="orbits" viewBox="0 0 640 520" fill="none">
			<defs>
				<linearGradient id="orbit-warm" x1="80" y1="60" x2="560" y2="360" gradientUnits="userSpaceOnUse">
					<stop offset="0%" stop-color="var(--accent-orange)"></stop>
					<stop offset="55%" stop-color="var(--accent-rose)"></stop>
					<stop offset="100%" stop-color="var(--accent-orange)"></stop>
				</linearGradient>
				<linearGradient id="orbit-cool" x1="520" y1="40" x2="120" y2="380" gradientUnits="userSpaceOnUse">
					<stop offset="0%" stop-color="var(--accent-rose)"></stop>
					<stop offset="100%" stop-color="var(--accent-orange)"></stop>
				</linearGradient>
				<!-- Grain applied only to painted orbit pixels -->
				<filter
					id="orbit-grain"
					x="-20%"
					y="-20%"
					width="140%"
					height="140%"
					color-interpolation-filters="sRGB"
				>
					<feTurbulence
						type="fractalNoise"
						baseFrequency="1.15"
						numOctaves="3"
						stitchTiles="stitch"
						result="noise"></feTurbulence>
					<feColorMatrix
						in="noise"
						type="matrix"
						values="0 0 0 0 0.55
                  0 0 0 0 0.35
                  0 0 0 0 0.28
                  0 0 0 0.55 0"
						result="mono"></feColorMatrix>
					<feBlend in="SourceGraphic" in2="mono" mode="overlay" result="grained"></feBlend>
					<feComposite in="grained" in2="SourceGraphic" operator="in"></feComposite>
				</filter>
			</defs>

			<g class="orbit-field" filter="url(#orbit-grain)">
				{
					orbits.map((orbit) => (
						<g
							class:list={['orbit', `orbit-${orbit.id}`, { reverse: orbit.reverse }]}
							style={`--orbit-duration: ${orbit.duration}; --orbit-opacity: ${orbit.opacity}; --orbit-rotate: ${orbit.rotate}deg;`}
						>
							<circle
								cx={cx}
								cy={cy}
								r={orbit.r}
								stroke={`url(#orbit-${orbit.gradient})`}
								stroke-width={orbit.width}
								stroke-dasharray={orbit.dash}
								stroke-linecap="round"
								fill="none"
								class="trail"
							/>
							{orbit.dots.map((dot) => {
								const { x, y } = point(orbit.r, dot.deg);
								return dot.kind === 'solid' ? (
									<circle
										cx={x}
										cy={y}
										r={dot.size}
										fill={`url(#orbit-${orbit.gradient})`}
										class="marker solid"
									/>
								) : (
									<circle
										cx={x}
										cy={y}
										r={dot.size}
										fill="none"
										stroke={`url(#orbit-${orbit.gradient})`}
										stroke-width="1.15"
										class="marker hollow"
									/>
								);
							})}
						</g>
					))
				}
			</g>
		</svg>
	</div>

	<div class="identity">
		<h1 class="name">{site.name}</h1>
		<div class="cta">
			<SocialLinks />
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		min-height: clamp(22rem, 54vh, 32rem);
		padding: 1.5rem 0;
		overflow: hidden;
		border-bottom: 1px solid var(--hairline);
	}

	.glow {
		position: absolute;
		inset: 0;
		background:
			radial-gradient(circle 42% at 50% 50%, var(--hero-glow), transparent 72%),
			radial-gradient(circle 30% at 58% 52%, var(--hero-glow-soft), transparent 70%);
		pointer-events: none;
		z-index: 0;
	}

	.orbit-stage {
		position: absolute;
		inset: 0;
		z-index: 0;
		pointer-events: none;
	}

	.orbits {
		position: absolute;
		left: 50%;
		top: 50%;
		width: min(38rem, 96%);
		max-height: 94%;
		transform: translate(-50%, -50%);
	}

	.orbit {
		transform-origin: 320px 260px;
		opacity: var(--orbit-opacity);
		animation: orbit-spin var(--orbit-duration) linear infinite;
	}

	.orbit.reverse {
		animation-direction: reverse;
	}

	.marker.solid {
		opacity: 0.95;
	}

	.marker.hollow {
		opacity: 0.85;
	}

	.identity {
		position: relative;
		z-index: 1;
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1.5rem 2rem;
		width: 100%;
	}

	.name {
		margin: 0;
		font-size: clamp(1.85rem, 4.5vw, 3rem);
		font-weight: 700;
		letter-spacing: -0.035em;
		line-height: 1.1;
		text-align: left;
	}

	.cta {
		flex-shrink: 0;
	}

	@keyframes orbit-spin {
		from {
			transform: rotate(var(--orbit-rotate));
		}
		to {
			transform: rotate(calc(var(--orbit-rotate) + 360deg));
		}
	}

	@media (max-width: 768px) {
		.hero {
			justify-content: flex-start;
			min-height: 0;
			padding: 1rem 0 1.35rem;
			gap: 0.35rem;
		}

		.glow {
			background:
				radial-gradient(circle 55% at 50% 28%, var(--hero-glow), transparent 72%),
				radial-gradient(circle 40% at 55% 32%, var(--hero-glow-soft), transparent 70%);
		}

		.orbit-stage {
			position: relative;
			inset: auto;
			display: grid;
			place-items: center;
			width: 100%;
			height: clamp(14rem, 42vw, 18rem);
			flex-shrink: 0;
		}

		.orbits {
			position: relative;
			left: auto;
			top: auto;
			width: min(22rem, 88%);
			max-height: 100%;
			transform: none;
		}

		.identity {
			flex-direction: column;
			align-items: flex-start;
			gap: 1rem;
			padding-top: 0.15rem;
		}

		.name {
			font-size: clamp(1.7rem, 8vw, 2.35rem);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.orbit {
			animation: none;
			transform: rotate(var(--orbit-rotate));
		}
	}
</style>
