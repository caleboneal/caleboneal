---
import { site } from '../data/site';
import HeroStarburst from './HeroStarburst.astro';
import SocialLinks from './SocialLinks.astro';
---

<section class="hero">
	<div class="glow" aria-hidden="true"></div>
	<HeroStarburst />
	<div class="identity">
		<h1 class="name">{site.name}</h1>
		<div class="cta">
			<SocialLinks />
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		min-height: clamp(22rem, 54vh, 32rem);
		padding: 1.5rem 0;
		overflow: hidden;
		border-bottom: 1px solid var(--hairline);
	}

	.glow {
		position: absolute;
		inset: 0;
		background:
			radial-gradient(circle 42% at 50% 50%, var(--hero-glow), transparent 72%),
			radial-gradient(circle 30% at 58% 52%, var(--hero-glow-soft), transparent 70%);
		pointer-events: none;
		z-index: 0;
	}

	.identity {
		position: relative;
		z-index: 1;
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1.5rem 2rem;
		width: 100%;
	}

	.name {
		margin: 0;
		font-size: clamp(1.85rem, 4.5vw, 3rem);
		font-weight: 700;
		letter-spacing: -0.035em;
		line-height: 1.1;
		text-align: left;
	}

	.cta {
		flex-shrink: 0;
	}

	@media (max-width: 768px) {
		.hero {
			justify-content: flex-start;
			min-height: 0;
			padding: 0.65rem 0 0.95rem;
			gap: 0.2rem;
		}

		.glow {
			background:
				radial-gradient(circle 55% at 50% 28%, var(--hero-glow), transparent 72%),
				radial-gradient(circle 40% at 55% 32%, var(--hero-glow-soft), transparent 70%);
		}

		.identity {
			flex-direction: column;
			align-items: center;
			gap: 0.75rem;
			padding-top: 0;
		}

		.name {
			font-size: clamp(1.7rem, 8vw, 2.35rem);
			text-align: center;
		}
	}
</style>
