---
import { site } from '../data/site';
import HeroStarburst from './HeroStarburst.astro';
import SocialLinks from './SocialLinks.astro';
---

<section class="hero">
	<div class="glow" aria-hidden="true"></div>
	<HeroStarburst />
	<div class="identity">
		<h1 class="name">{site.name}</h1>
		<div class="cta">
			<SocialLinks />
		</div>
	</div>
</section>

<script>
	const stage = document.querySelector('.hero .orbit-stage');
	if (stage instanceof HTMLElement) {
		const clearEnter = () => {
			stage.classList.remove('starburst-enter');
		};

		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
			clearEnter();
		} else {
			const onEnterEnd = (event) => {
				if (
					event.target !== stage ||
					(event.animationName !== 'hero-starburst-rise' &&
						event.animationName !== 'hero-starburst-rise-mobile')
				) {
					return;
				}
				clearEnter();
				stage.removeEventListener('animationend', onEnterEnd);
			};
			stage.addEventListener('animationend', onEnterEnd);

			// If the enter animation already finished before this script ran, clear it.
			window.setTimeout(clearEnter, 2500);
		}
	}
</script>

<style>
	.hero {
		position: relative;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		min-height: clamp(22rem, 54vh, 32rem);
		padding: 1.5rem 0;
		overflow: hidden;
		border-bottom: 1px solid var(--hairline);
	}

	.glow {
		position: absolute;
		inset: 0;
		background:
			radial-gradient(circle 42% at 50% 50%, var(--hero-glow), transparent 72%),
			radial-gradient(circle 30% at 58% 52%, var(--hero-glow-soft), transparent 70%);
		pointer-events: none;
		z-index: 0;
	}

	.identity {
		position: relative;
		z-index: 1;
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1.5rem 2rem;
		width: 100%;
	}

	.name {
		margin: 0;
		font-size: clamp(1.85rem, 4.5vw, 3rem);
		font-weight: 700;
		letter-spacing: -0.035em;
		line-height: 1.1;
		text-align: left;
	}

	.cta {
		flex-shrink: 0;
	}

	@media (prefers-reduced-motion: no-preference) {
		.hero :global(.orbit-stage.starburst-enter) {
			transform: translateY(52%);
			animation: hero-starburst-rise 2.4s cubic-bezier(0.33, 0.1, 0.25, 1) forwards;
		}

		.hero :global(.orbit-stage.theme-set-down) {
			animation: hero-starburst-set-down 1.2s cubic-bezier(0.33, 0.1, 0.25, 1) forwards;
		}

		.hero :global(.orbit-stage.theme-set-up) {
			animation: hero-starburst-set-up 1.2s cubic-bezier(0.33, 0.1, 0.25, 1) forwards;
		}

		.name,
		.cta {
			opacity: 0;
			transform: translateY(0.55rem);
			animation: hero-enter 420ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
		}

		.name {
			animation-delay: 80ms;
		}

		.cta {
			animation-delay: 135ms;
		}
	}

	@keyframes hero-starburst-rise {
		from {
			transform: translateY(52%);
		}
		to {
			transform: translateY(0);
		}
	}

	@keyframes hero-starburst-set-down {
		from {
			transform: translateY(0);
		}
		to {
			transform: translateY(52%);
		}
	}

	@keyframes hero-starburst-set-up {
		from {
			transform: translateY(52%);
		}
		to {
			transform: translateY(0);
		}
	}

	@keyframes hero-enter {
		from {
			opacity: 0;
			transform: translateY(0.55rem);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.name,
		.cta {
			opacity: 1;
			transform: none;
			animation: none;
		}

		.hero :global(.orbit-stage) {
			transform: none;
			animation: none;
		}
	}

	@media (max-width: 768px) {
		.hero {
			justify-content: flex-start;
			min-height: 0;
			padding: 0.2rem 0 0.35rem;
			gap: 0.1rem;
		}

		.glow {
			background:
				radial-gradient(circle 55% at 50% 28%, var(--hero-glow), transparent 72%),
				radial-gradient(circle 40% at 55% 32%, var(--hero-glow-soft), transparent 70%);
		}

		.identity {
			flex-direction: column;
			align-items: center;
			gap: 0.5rem;
			padding-top: 0;
		}

		.name {
			font-size: clamp(1.7rem, 8vw, 2.35rem);
			text-align: center;
		}

		@media (prefers-reduced-motion: no-preference) {
			.hero :global(.orbit-stage.starburst-enter) {
				transform: translateY(48%);
				animation-name: hero-starburst-rise-mobile;
			}

			.hero :global(.orbit-stage.theme-set-down) {
				animation-name: hero-starburst-set-down-mobile;
			}

			.hero :global(.orbit-stage.theme-set-up) {
				animation-name: hero-starburst-set-up-mobile;
			}
		}
	}

	@keyframes hero-starburst-rise-mobile {
		from {
			transform: translateY(48%);
		}
		to {
			transform: translateY(0);
		}
	}

	@keyframes hero-starburst-set-down-mobile {
		from {
			transform: translateY(0);
		}
		to {
			transform: translateY(48%);
		}
	}

	@keyframes hero-starburst-set-up-mobile {
		from {
			transform: translateY(48%);
		}
		to {
			transform: translateY(0);
		}
	}
</style>
