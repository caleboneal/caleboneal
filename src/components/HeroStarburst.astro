---
const cx = 320;
const cy = 260;
const burstInner = 66;
const rayCount = 36;

function rayOuterRadius(index: number) {
	const lengthSeed = Math.sin((index + 1) * 1.9) * 0.5 + Math.cos((index + 2) * 0.73) * 0.5;
	return 142 + ((lengthSeed + 1) / 2) * 64;
}

const burstOuter = Math.max(...Array.from({ length: rayCount }, (_, i) => rayOuterRadius(i)));
const burstEdge = burstOuter * 0.88;
const glowRadius = 118;
const innerGlowEdge = (burstInner / glowRadius) * 100;

const satellites = [
	{ orbit: 156, size: 5.5, duration: 39.1, reverse: false, start: 0 },
	{ orbit: 174, size: 4.2, duration: 52.9, reverse: true, start: 120 },
	{ orbit: 194, size: 6.5, duration: 66.7, reverse: false, start: 240 },
] as const;

/** Point on a circle at degrees (0 = right, CCW). */
function point(radius: number, deg: number) {
	const rad = (deg * Math.PI) / 180;
	return {
		x: +(cx + radius * Math.cos(rad)).toFixed(2),
		y: +(cy + radius * Math.sin(rad)).toFixed(2),
	};
}

function rayPulseDuration(index: number) {
	return +((5.5 + ((Math.sin((index + 1) * 2.17) + 1) / 2) * 7.5 + (index % 5) * 0.55) * 1.15).toFixed(2);
}
---

<div class="orbit-stage" aria-hidden="true">
	<svg class="orbits" viewBox="0 0 640 520">
		<defs>
			<linearGradient id="burst-warm" x1="120" y1="80" x2="520" y2="400" gradientUnits="userSpaceOnUse">
				<stop offset="0%" stop-color="var(--accent-orange)"></stop>
				<stop offset="42%" stop-color="var(--accent-rose)"></stop>
				<stop offset="78%" stop-color="var(--accent-orange)"></stop>
				<stop offset="100%" stop-color="var(--accent-rose)"></stop>
			</linearGradient>
			<radialGradient id="burst-radial" cx={cx} cy={cy} r={burstEdge} gradientUnits="userSpaceOnUse">
				<stop offset="0%" stop-color="var(--accent-rose)"></stop>
				<stop offset="55%" stop-color="var(--accent-orange)"></stop>
				<stop offset="100%" stop-color="var(--accent-rose)"></stop>
			</radialGradient>
			<radialGradient id="inner-glow" cx={cx} cy={cy} r={glowRadius} gradientUnits="userSpaceOnUse">
				<stop offset="0%" stop-color="var(--accent-orange)" stop-opacity="0"></stop>
				<stop offset={`${innerGlowEdge}%`} stop-color="var(--accent-orange)" stop-opacity="0"></stop>
				<stop offset={`${innerGlowEdge + 5}%`} stop-color="var(--accent-rose)" stop-opacity="0.32"></stop>
				<stop offset={`${innerGlowEdge + 16}%`} stop-color="var(--accent-orange)" stop-opacity="0.14"></stop>
				<stop offset="100%" stop-color="var(--accent-rose)" stop-opacity="0"></stop>
			</radialGradient>
			<filter
				id="inner-glow-blur"
				x="-50%"
				y="-50%"
				width="200%"
				height="200%"
				color-interpolation-filters="sRGB"
			>
				<feGaussianBlur stdDeviation="10" result="blur"></feGaussianBlur>
			</filter>
			<filter
				id="orbit-grain"
				x="-45%"
				y="-45%"
				width="190%"
				height="190%"
				filterUnits="objectBoundingBox"
				color-interpolation-filters="sRGB"
			>
				<feTurbulence
					type="fractalNoise"
					baseFrequency="1.1"
					numOctaves="5"
					seed="7"
					stitchTiles="stitch"
					result="noise"
				></feTurbulence>
				<feDisplacementMap
					in="SourceGraphic"
					in2="noise"
					scale="5.5"
					xChannelSelector="R"
					yChannelSelector="G"
					result="displaced"
				></feDisplacementMap>
				<feColorMatrix
					in="noise"
					type="matrix"
					values="1 0 0 0 -0.35
                  1 0 0 0 -0.35
                  1 0 0 0 -0.35
                  0 0 0 1.4 0"
					result="grain"
				></feColorMatrix>
				<feBlend in="displaced" in2="grain" mode="hard-light" result="speckled"></feBlend>
				<feComposite in="speckled" in2="displaced" operator="in"></feComposite>
			</filter>
		</defs>

		<g class="orbit-field">
			<circle
				class="inner-glow"
				cx={cx}
				cy={cy}
				r={glowRadius}
				fill="url(#inner-glow)"
				filter="url(#inner-glow-blur)"
			/>
			<g class="starburst" filter="url(#orbit-grain)">
				<circle cx={cx} cy={cy} r="128" class="burst-ring outer" />
				<circle cx={cx} cy={cy} r={burstInner} class="burst-ring inner" />
				<circle cx={cx} cy={cy} r={burstEdge} class="burst-ring edge" />
				{
					Array.from({ length: rayCount }).map((_, i) => {
						const deg = i * (360 / rayCount);
						const outer = rayOuterRadius(i);
						const outerMin = outer * 0.78;
						const outerMax = outer * 1.1;
						const spread = 1.7 + ((Math.sin((i + 4) * 1.17) + 1) / 2) * 2.6;
						const tip = point(outer, deg);
						const tipMin = point(outerMin, deg);
						const tipMax = point(outerMax, deg);
						const left = point(burstInner, deg - spread);
						const right = point(burstInner, deg + spread);
						const pulseDur = rayPulseDuration(i);
						const tipValuesX = `${tipMin.x};${tipMax.x};${tipMin.x}`;
						const tipValuesY = `${tipMin.y};${tipMax.y};${tipMin.y}`;
						return (
							<g class="burst-ray">
								<line x1={tip.x} y1={tip.y} x2={left.x} y2={left.y} class="burst-spoke">
									<animate
										attributeName="x1"
										values={tipValuesX}
										dur={`${pulseDur}s`}
										repeatCount="indefinite"
									/>
									<animate
										attributeName="y1"
										values={tipValuesY}
										dur={`${pulseDur}s`}
										repeatCount="indefinite"
									/>
								</line>
								<line x1={tip.x} y1={tip.y} x2={right.x} y2={right.y} class="burst-spoke">
									<animate
										attributeName="x1"
										values={tipValuesX}
										dur={`${pulseDur}s`}
										repeatCount="indefinite"
									/>
									<animate
										attributeName="y1"
										values={tipValuesY}
										dur={`${pulseDur}s`}
										repeatCount="indefinite"
									/>
								</line>
							</g>
						);
					})
				}
			</g>
			<g class="satellite-field" filter="url(#orbit-grain)">
				{
					satellites.map((sat) => {
						const from = sat.reverse ? 360 : 0;
						const to = sat.reverse ? 0 : 360;
						const body = point(sat.orbit, sat.start);
						return (
							<g>
								<animateTransform
									attributeName="transform"
									type="rotate"
									from={`${from} ${cx} ${cy}`}
									to={`${to} ${cx} ${cy}`}
									dur={`${sat.duration}s`}
									repeatCount="indefinite"
								/>
								<circle
									class="satellite"
									cx={body.x}
									cy={body.y}
									r={sat.size}
									fill="none"
									stroke="var(--accent-rose)"
									stroke-width="1.6"
								/>
							</g>
						);
					})
				}
			</g>
		</g>
	</svg>
</div>

<style>
	.orbit-stage {
		position: absolute;
		inset: 0;
		z-index: 0;
		pointer-events: none;
	}

	.orbits {
		position: absolute;
		left: 50%;
		top: 50%;
		width: min(38rem, 96%);
		max-height: 94%;
		transform: translate(-50%, -50%);
	}

	.burst-ring {
		fill: none;
		stroke: url(#burst-radial);
	}

	.burst-ring.outer {
		stroke-width: 1.4;
	}

	.burst-ring.inner {
		stroke-width: 1.15;
	}

	.burst-ring.edge {
		stroke-width: 1.35;
	}

	.burst-spoke {
		stroke: url(#burst-warm);
		stroke-width: 1.2;
		stroke-linecap: butt;
	}

	@media (prefers-reduced-motion: reduce) {
		.satellite-field :global(animateTransform),
		.burst-ray :global(animate) {
			display: none;
		}
	}

	@media (max-width: 768px) {
		.orbit-stage {
			position: relative;
			inset: auto;
			display: grid;
			place-items: center;
			width: 100%;
			height: clamp(17.5rem, 58vw, 23rem);
			flex-shrink: 0;
		}

		.orbits {
			position: relative;
			left: auto;
			top: auto;
			width: min(28rem, 100%);
			max-height: 100%;
			transform: none;
		}
	}
</style>
