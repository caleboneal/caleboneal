---
const cx = 320;
const cy = 260;
const burstInner = 66;
const rayCount = 36;

function rayOuterRadius(index: number) {
	const lengthSeed = Math.sin((index + 1) * 1.9) * 0.5 + Math.cos((index + 2) * 0.73) * 0.5;
	return 142 + ((lengthSeed + 1) / 2) * 64;
}

const burstOuter = Math.max(...Array.from({ length: rayCount }, (_, i) => rayOuterRadius(i)));
const burstEdge = burstOuter * 0.88;
const glowRadius = 118;
const innerGlowEdge = (burstInner / glowRadius) * 100;

/** Point on a circle at degrees (0 = right, CCW). */
function point(radius: number, deg: number) {
	const rad = (deg * Math.PI) / 180;
	return {
		x: +(cx + radius * Math.cos(rad)).toFixed(2),
		y: +(cy + radius * Math.sin(rad)).toFixed(2),
	};
}
---

<div class="orbit-stage" aria-hidden="true">
	<svg class="orbits" viewBox="0 0 640 520" fill="none">
		<defs>
			<linearGradient id="burst-warm" x1="120" y1="80" x2="520" y2="400" gradientUnits="userSpaceOnUse">
				<stop offset="0%" stop-color="var(--accent-orange)"></stop>
				<stop offset="42%" stop-color="var(--accent-rose)"></stop>
				<stop offset="78%" stop-color="var(--accent-orange)"></stop>
				<stop offset="100%" stop-color="var(--accent-rose)"></stop>
			</linearGradient>
			<radialGradient id="burst-radial" cx={cx} cy={cy} r={burstEdge} gradientUnits="userSpaceOnUse">
				<stop offset="0%" stop-color="var(--accent-rose)"></stop>
				<stop offset="55%" stop-color="var(--accent-orange)"></stop>
				<stop offset="100%" stop-color="var(--accent-rose)"></stop>
			</radialGradient>
			<radialGradient id="inner-glow" cx={cx} cy={cy} r={glowRadius} gradientUnits="userSpaceOnUse">
				<stop offset="0%" stop-color="var(--accent-orange)" stop-opacity="0"></stop>
				<stop offset={`${innerGlowEdge}%`} stop-color="var(--accent-orange)" stop-opacity="0"></stop>
				<stop offset={`${innerGlowEdge + 5}%`} stop-color="var(--accent-rose)" stop-opacity="0.32"></stop>
				<stop offset={`${innerGlowEdge + 16}%`} stop-color="var(--accent-orange)" stop-opacity="0.14"></stop>
				<stop offset="100%" stop-color="var(--accent-rose)" stop-opacity="0"></stop>
			</radialGradient>
			<filter
				id="inner-glow-blur"
				x="-50%"
				y="-50%"
				width="200%"
				height="200%"
				color-interpolation-filters="sRGB"
			>
				<feGaussianBlur stdDeviation="10" result="blur"></feGaussianBlur>
			</filter>
			<filter
				id="orbit-grain"
				x="-25%"
				y="-25%"
				width="150%"
				height="150%"
				color-interpolation-filters="sRGB"
			>
				<feTurbulence
					type="fractalNoise"
					baseFrequency="1.35"
					numOctaves="4"
					stitchTiles="stitch"
					result="coarse"></feTurbulence>
				<feTurbulence
					type="fractalNoise"
					baseFrequency="2.8"
					numOctaves="2"
					stitchTiles="stitch"
					result="fine"></feTurbulence>
				<feBlend in="coarse" in2="fine" mode="multiply" result="noise"></feBlend>
				<feColorMatrix
					in="noise"
					type="matrix"
					values="0 0 0 0 0.52
                  0 0 0 0 0.32
                  0 0 0 0 0.26
                  0 0 0 0.62 0"
					result="mono"></feColorMatrix>
				<feBlend in="SourceGraphic" in2="mono" mode="soft-light" result="grained"></feBlend>
				<feComposite in="grained" in2="SourceGraphic" operator="in"></feComposite>
			</filter>
		</defs>

		<g class="orbit-field">
			<circle
				class="inner-glow"
				cx={cx}
				cy={cy}
				r={glowRadius}
				fill="url(#inner-glow)"
				filter="url(#inner-glow-blur)"
			/>
			<g class="starburst" filter="url(#orbit-grain)">
				<circle cx={cx} cy={cy} r="128" class="burst-ring outer" />
				<circle cx={cx} cy={cy} r={burstInner} class="burst-ring inner" />
				<circle cx={cx} cy={cy} r={burstEdge} class="burst-ring edge" />
				{
					Array.from({ length: rayCount }).map((_, i) => {
						const deg = i * (360 / rayCount);
						const outer = rayOuterRadius(i);
						const spread = 1.7 + ((Math.sin((i + 4) * 1.17) + 1) / 2) * 2.6;
						const tip = point(outer, deg);
						const left = point(burstInner, deg - spread);
						const right = point(burstInner, deg + spread);
						return (
							<g class="burst-ray">
								<line x1={tip.x} y1={tip.y} x2={left.x} y2={left.y} class="burst-spoke" />
								<line x1={tip.x} y1={tip.y} x2={right.x} y2={right.y} class="burst-spoke" />
							</g>
						);
					})
				}
			</g>
		</g>
	</svg>
</div>

<style>
	.orbit-stage {
		position: absolute;
		inset: 0;
		z-index: 0;
		pointer-events: none;
	}

	.orbits {
		position: absolute;
		left: 50%;
		top: 50%;
		width: min(38rem, 96%);
		max-height: 94%;
		transform: translate(-50%, -50%);
	}

	.burst-ring {
		fill: none;
		stroke: url(#burst-radial);
	}

	.burst-ring.outer {
		stroke-width: 1.4;
	}

	.burst-ring.inner {
		stroke-width: 1.15;
	}

	.burst-ring.edge {
		stroke-width: 1.35;
	}

	.burst-spoke {
		stroke: url(#burst-warm);
		stroke-width: 1.2;
		stroke-linecap: butt;
	}

	@media (max-width: 768px) {
		.orbit-stage {
			position: relative;
			inset: auto;
			display: grid;
			place-items: center;
			width: 100%;
			height: clamp(15rem, 48vw, 20rem);
			flex-shrink: 0;
		}

		.orbits {
			position: relative;
			left: auto;
			top: auto;
			width: min(24.5rem, 96%);
			max-height: 100%;
			transform: none;
		}
	}
</style>
