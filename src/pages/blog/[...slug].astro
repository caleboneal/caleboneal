---
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import BlogArticle from '../../components/BlogArticle.astro';
import BlogLink from '../../components/BlogLink.astro';
import { buildPostNumberMap, getAdjacentPosts, getRoutablePosts } from '../../data/blog';
import { getReadingTimeMinutes } from '../../utils/readingTime';

export async function getStaticPaths() {
	const posts = await getRoutablePosts();
	const postNumbers = buildPostNumberMap(posts);
	return posts.map((post) => ({
		params: { slug: post.id },
		props: {
			post,
			number: postNumbers.get(post.id),
			...getAdjacentPosts(posts, post.id),
		},
	}));
}

const { post, number, previous, next } = Astro.props;
const { Content } = await render(post, {
	components: { BlogLink },
});
const readingTime = getReadingTimeMinutes(post.body ?? '');
---

<Layout title={post.data.title} description={post.data.description} image={post.data.image} type="article">
	<BlogArticle
		title={post.data.title}
		description={post.data.description}
		date={post.data.pubDate}
		updatedDate={post.data.updatedDate}
		readingTime={readingTime}
		number={number}
		previous={previous}
		next={next}
	>
		<Content />
	</BlogArticle>
</Layout>
