{
	"name": "caleb-dark",
	"type": "dark",
	"colors": {
		"editor.background": "#12101a",
		"editor.foreground": "#f2efe8"
	},
	"tokenColors": [
		{
			"scope": ["comment", "punctuation.definition.comment", "string.comment"],
			"settings": {
				"foreground": "#8a8496",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"keyword",
				"keyword.control",
				"keyword.operator.new",
				"keyword.operator.expression",
				"storage",
				"storage.type",
				"storage.modifier",
				"token.storage"
			],
			"settings": {
				"foreground": "#e07a88"
			}
		},
		{
			"scope": ["string", "string.quoted", "string.template", "string.regexp"],
			"settings": {
				"foreground": "#e8925c"
			}
		},
		{
			"scope": [
				"constant",
				"constant.numeric",
				"constant.language",
				"constant.character",
				"support.constant"
			],
			"settings": {
				"foreground": "#f0b48a"
			}
		},
		{
			"scope": [
				"entity.name.function",
				"support.function",
				"meta.function-call",
				"variable.function"
			],
			"settings": {
				"foreground": "#f0a070"
			}
		},
		{
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"support.class",
				"support.type",
				"entity.name.namespace"
			],
			"settings": {
				"foreground": "#e8a0aa"
			}
		},
		{
			"scope": ["variable", "meta.definition.variable", "variable.other"],
			"settings": {
				"foreground": "#f2efe8"
			}
		},
		{
			"scope": ["variable.parameter", "variable.language", "variable.language.this"],
			"settings": {
				"foreground": "#d4c4e0",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"entity.name.tag",
				"punctuation.definition.tag",
				"punctuation.definition.tag.html"
			],
			"settings": {
				"foreground": "#e07a88"
			}
		},
		{
			"scope": ["entity.other.attribute-name", "meta.tag.attribute"],
			"settings": {
				"foreground": "#e8925c"
			}
		},
		{
			"scope": [
				"punctuation",
				"meta.brace",
				"keyword.operator",
				"keyword.operator.assignment",
				"keyword.operator.arithmetic",
				"keyword.operator.comparison"
			],
			"settings": {
				"foreground": "#b8b0c4"
			}
		},
		{
			"scope": ["markup.heading", "entity.name.section"],
			"settings": {
				"foreground": "#e8925c",
				"fontStyle": "bold"
			}
		},
		{
			"scope": ["markup.bold"],
			"settings": {
				"foreground": "#f0b48a",
				"fontStyle": "bold"
			}
		},
		{
			"scope": ["markup.italic"],
			"settings": {
				"foreground": "#e07a88",
				"fontStyle": "italic"
			}
		},
		{
			"scope": ["markup.inline.raw", "markup.inline.raw.string"],
			"settings": {
				"foreground": "#e8925c"
			}
		},
		{
			"scope": ["markup.underline.link"],
			"settings": {
				"foreground": "#e07a88"
			}
		},
		{
			"scope": ["invalid", "invalid.illegal"],
			"settings": {
				"foreground": "#ff8a9a"
			}
		}
	]
}
